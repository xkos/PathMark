{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Reading Library Export v1",
  "$id": "https://local.example/schemas/reading-bookmarks-export-v1.json",
  "type": "object",
  "required": ["format", "formatVersion", "exportedAt", "app", "settings", "collections", "sites", "items"],
  "properties": {
    "format": { "const": "reading-bookmarks" },
    "formatVersion": { "const": 1 },
    "exportedAt": { "$ref": "#/$defs/dateTime" },
    "app": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "settings": { "$ref": "#/$defs/settings" },
    "collections": {
      "type": "array",
      "items": { "$ref": "#/$defs/collection" }
    },
    "sites": {
      "type": "array",
      "items": { "$ref": "#/$defs/site" }
    },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "httpUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "queryPolicy": {
      "oneOf": [
        {
          "type": "object",
          "required": ["mode", "ignoredParams"],
          "properties": {
            "mode": { "const": "keep-all-except-ignored" },
            "ignoredParams": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["mode", "identityParams"],
          "properties": {
            "mode": { "const": "keep-only-identity" },
            "identityParams": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "collection": {
      "type": "object",
      "required": ["id", "name", "parentId", "sortOrder", "createdAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1 },
        "parentId": {
          "oneOf": [
            { "$ref": "#/$defs/uuid" },
            { "type": "null" }
          ]
        },
        "sortOrder": { "type": "integer", "minimum": 0 },
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "updatedAt": { "$ref": "#/$defs/dateTime" }
      },
      "additionalProperties": true
    },
    "endpoint": {
      "type": "object",
      "required": ["id", "prefix", "priority", "enabled", "createdAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "prefix": { "$ref": "#/$defs/httpUrl" },
        "priority": { "type": "integer", "minimum": 0 },
        "enabled": { "type": "boolean" },
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "updatedAt": { "$ref": "#/$defs/dateTime" }
      },
      "additionalProperties": true
    },
    "site": {
      "type": "object",
      "required": ["id", "name", "description", "endpoints", "queryPolicy", "createdAt", "updatedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "endpoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/endpoint" }
        },
        "queryPolicy": { "$ref": "#/$defs/queryPolicy" },
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "updatedAt": { "$ref": "#/$defs/dateTime" }
      },
      "additionalProperties": true
    },
    "item": {
      "type": "object",
      "required": [
        "id", "title", "note", "tags", "collectionId", "siteId", "resourceKey", "canonicalKey",
        "originalUrl", "lastResolvedUrl", "readingState", "isArchived", "createdAt",
        "updatedAt", "firstReadAt", "readAt", "lastOpenedAt", "openCount"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "title": { "type": "string", "minLength": 1 },
        "note": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "collectionId": {
          "oneOf": [
            { "$ref": "#/$defs/uuid" },
            { "type": "null" }
          ]
        },
        "siteId": {
          "oneOf": [
            { "$ref": "#/$defs/uuid" },
            { "type": "null" }
          ]
        },
        "resourceKey": {
          "oneOf": [
            { "type": "string", "pattern": "^/" },
            { "type": "null" }
          ]
        },
        "canonicalKey": { "type": "string", "pattern": "^v1:(site|url):" },
        "originalUrl": { "$ref": "#/$defs/httpUrl" },
        "lastResolvedUrl": {
          "oneOf": [
            { "$ref": "#/$defs/httpUrl" },
            { "type": "null" }
          ]
        },
        "readingState": { "enum": ["unread", "reading", "read"] },
        "isArchived": { "type": "boolean" },
        "createdAt": { "$ref": "#/$defs/dateTime" },
        "updatedAt": { "$ref": "#/$defs/dateTime" },
        "firstReadAt": {
          "oneOf": [
            { "$ref": "#/$defs/dateTime" },
            { "type": "null" }
          ]
        },
        "readAt": {
          "oneOf": [
            { "$ref": "#/$defs/dateTime" },
            { "type": "null" }
          ]
        },
        "lastOpenedAt": {
          "oneOf": [
            { "$ref": "#/$defs/dateTime" },
            { "type": "null" }
          ]
        },
        "openCount": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "siteId": { "type": "null" } },
            "required": ["siteId"]
          },
          "then": { "properties": { "resourceKey": { "type": "null" } } },
          "else": { "properties": { "resourceKey": { "type": "string", "pattern": "^/" } } }
        },
        {
          "if": {
            "properties": { "readingState": { "const": "read" } },
            "required": ["readingState"]
          },
          "then": {
            "properties": {
              "firstReadAt": { "$ref": "#/$defs/dateTime" },
              "readAt": { "$ref": "#/$defs/dateTime" }
            }
          },
          "else": { "properties": { "readAt": { "type": "null" } } }
        },
        {
          "if": {
            "properties": { "readAt": { "$ref": "#/$defs/dateTime" } },
            "required": ["readAt"]
          },
          "then": { "properties": { "firstReadAt": { "$ref": "#/$defs/dateTime" } } }
        }
      ],
      "additionalProperties": true
    },
    "settings": {
      "type": "object",
      "required": ["globalIgnoredQueryParams", "stripTrailingSlash", "defaultReadingState", "defaultView"],
      "properties": {
        "globalIgnoredQueryParams": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "stripTrailingSlash": { "type": "boolean" },
        "defaultReadingState": { "enum": ["unread", "reading", "read"] },
        "defaultView": { "enum": ["inbox", "unread", "all"] }
      },
      "additionalProperties": true
    }
  }
}
